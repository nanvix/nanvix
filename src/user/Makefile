all: all-hello-c all-hello-cpp

clean: clean-hello-c clean-hello-cpp

all-hello-c:
	$(MAKE_QUIET) -C hello-c

clean-hello-c:
	$(MAKE_QUIET) -C hello-c clean

all-hello-cpp:
	$(MAKE_QUIET) -C hello-cpp

clean-hello-cpp:
	$(MAKE_QUIET) -C hello-cpp clean
