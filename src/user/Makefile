all:  all-hello-c all-hello-cpp all-hello-js

clean: clean-hello-c clean-hello-cpp clean-hello-js

all-hello-c:
	$(MAKE) -C hello-c

clean-hello-c:
	$(MAKE) -C hello-c clean

all-hello-cpp:
	$(MAKE) -C hello-cpp

clean-hello-cpp:
	$(MAKE) -C hello-cpp clean

all-hello-js:
	$(MAKE) -C hello-js

clean-hello-js:
	$(MAKE) -C hello-js clean
