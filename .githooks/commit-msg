#
# Git hook for validating commit messages.
#

#==================================================================================================

# Fast fail on errors, unset variables, and pipe failures.
set -euo pipefail

#==================================================================================================
# Imports
#==================================================================================================

# Directory where to find scripts to import.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMPORT_DIR="$(cd "${SCRIPT_DIR}/../scripts/common" && pwd)"

source "${IMPORT_DIR}/logging.sh"
source "${IMPORT_DIR}/utils.sh"

#==================================================================================================
# Global Constants
#==================================================================================================

# Maximum length for commit message title.
MAX_COMMIT_MSG_TITLE_LENGTH=50

# Builtin module names that are not part of the Cargo workspace.
# Note: This is a space-separated list that will be split by get_all_modules().
BUILTIN_MODULES="build ci contrib doc git scripts tests"

#==================================================================================================
# Functions
#==================================================================================================

#
# Description
#   Extract package names from Cargo.toml workspace members.
#
# Arguments
#   $1 - The path to the repository root directory.
#
# Return
#   A sorted list of package names (one per line).
#
# Usage Example
#   workspace_members=$(get_workspace_members "/path/to/repo")
#
get_workspace_members() {
    local repo_root="$1"
    awk '
        # Detect [workspace] section start.
        /^\[workspace\]/ { in_workspace = 1; next }
        # Exit workspace section when another section starts.
        /^\[/ && !/^\[workspace/ { in_workspace = 0 }
        # Detect members array start within workspace section.
        in_workspace && /^members = \[/ { in_members = 1; next }
        # Detect members array end.
        in_members && /^[[:space:]]*\][[:space:]]*$/ { in_members = 0 }
        # Process member entries.
        in_members && /^[[:space:]]*"/ {
            # Extract the path from the quoted string (e.g., "src/kernel").
            match($0, /"([^"]+)"/, arr)
            path = arr[1]
            # Extract the last path component as the module name (e.g., "kernel").
            # This assumes the directory name matches the package name.
            n = split(path, parts, "/")
            print parts[n]
        }
    ' "${repo_root}/Cargo.toml" 2>/dev/null | sort -u
}

#
# Description
#   Get a sorted list of all valid modules (workspace members + fixed modules).
#
# Arguments
#   $1 - The workspace members (one per line).
#
# Return
#   A sorted list of all valid modules (one per line).
#
# Usage Example
#   all_modules=$(get_all_modules "$workspace_members")
#
get_all_modules() {
    local workspace_members="$1"
    printf "%s\n%s\n" "${workspace_members}" "${BUILTIN_MODULES}" | tr ' ' '\n' | grep -v '^$' | sort -u
}

#
# Description
#   Validate the commit message format.
#
# Arguments
#   $1 - The path to the commit message file.
#
# Return Value
#   0 on success, 1 on failure.
#
# Usage Example
#   validate_commit_msg "/path/to/commit/msg"
#
validate_commit_msg() {
    local commit_msg_file="$1"
    local commit_msg
    local commit_msg_title
    local repo_root
    local workspace_members
    local all_modules_list
    local all_modules_pattern

    # Read commit message.
    commit_msg=$(cat "${commit_msg_file}")
    commit_msg_title=$(echo "${commit_msg}" | head -n 1)

    # Check commit message title length.
    if [[ "${#commit_msg_title}" -gt "${MAX_COMMIT_MSG_TITLE_LENGTH}" ]]; then
        print_error "Commit message title is too long (maximum ${MAX_COMMIT_MSG_TITLE_LENGTH} characters)"
        return 1
    fi

    # Get the repository root directory.
    repo_root=$(get_repo_root)

    # Extract workspace members.
    workspace_members=$(get_workspace_members "${repo_root}")

    # Get all valid modules.
    all_modules_list=$(get_all_modules "${workspace_members}")

    # Combine modules into a regex pattern.
    all_modules_pattern=$(echo "${all_modules_list}" | paste -sd '|')

    # Verify we have valid modules before proceeding.
    if [[ -z "${all_modules_pattern}" ]]; then
        print_error "Failed to extract module names from Cargo.toml"
        return 1
    fi

    # Check if commit message matches the pattern.
    if ! echo "${commit_msg}" | grep -q -E "\\[(${all_modules_pattern})\\] (B|E|F|W): "; then
        print_error "Commit message does not match pattern: '[module-name] (B|E|F|W): Short Description'"
        print_info "Example: '[kernel] F: Fix memory leak in page allocator'"
        print_info "Valid modules are:"
        echo "${all_modules_list}"
        return 1
    fi

    return 0
}

#==================================================================================================
# Main Script
#==================================================================================================

main() {
    local commit_msg_file="$1"

    if ! validate_commit_msg "${commit_msg_file}"; then
        exit 1
    fi
}

main "$@"
