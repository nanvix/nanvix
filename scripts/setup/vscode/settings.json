{
    "editor.formatOnType": false,
    "editor.formatOnSave": true,
    "rust-analyzer.cargo.allTargets": false,
    "rust-analyzer.checkOnSave": true,
    // NOTE: Use './z --with-cached-options -- check' to ensure compatibility with the preferred build workflow during development.
    "rust-analyzer.check.overrideCommand": [
        "./z",
        "build",
        "--with-cached-options",
        "--",
        "check"
    ],
    // NOTE: Assuming that you have a symbolic link to the toolchain in your workspace folder.
    "C_Cpp.default.compilerPath": "${workspaceFolder}/toolchain/bin/i686-nanvix-gcc"
}
