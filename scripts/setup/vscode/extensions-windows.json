// Recommended Visual Studio Code Extensions for Nanvix Development on Windows
//
// How to use:
// 1. Create a folder named '.vscode' in the root of your Nanvix workspace.
// 2. Copy this file into the '.vscode' folder as 'extensions.json'.
// 3. Run 'Extensions: Show Recommended Extensions' and install the listed extensions.
{
    "recommendations": [
        // Rust language support, configured by 'settings-windows.json'.
        "rust-lang.rust-analyzer",
        // Native Windows debugger ('cppvsdbg') used by 'launch-windows.json'.
        "ms-vscode.cpptools",
        // TOML support for Cargo manifests and test configurations.
        "tamasfe.even-better-toml",
        // PowerShell support for 'z.ps1' and other Windows scripts.
        "ms-vscode.powershell",
        // Python support for 'z.py' and the build scripts.
        "ms-python.python",
        // ShellCheck diagnostics for shell scripts, which the 'lint-check' target enforces.
        "timonwong.shellcheck"
    ]
}
