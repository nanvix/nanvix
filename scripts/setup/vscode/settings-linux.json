// Visual Studio Code Settings for Nanvix Development on Linux
//
// How to use:
// 1. Create a folder named '.vscode' in the root of your Nanvix workspace.
// 2. Copy this file into the '.vscode' folder as 'settings.json'.
{
    //==============================================================================================
    // Editor Settings
    //==============================================================================================
    "editor.colorDecorators": false,
    "editor.formatOnType": false,
    "editor.formatOnSave": true,
    "editor.rulers": [
        100
    ],
    "vim.textwidth": 100,
    "files.watcherExclude": {
        "**/__pycache__/**": true,
        "**/.git/**": true,
        "**/.hg/**": true,
        "sysroot-*/**": true,
        "target/**": true
    },
    "files.exclude": {
        "**/__pycache__/**": true,
        "target/**": true,
        "**/*.elf": true
    },
    //==============================================================================================
    // Rust Analyzer Settings
    //==============================================================================================
    "rust-analyzer.cargo.allTargets": false,
    "rust-analyzer.cargo.extraEnv": {
        "MEMORY_SIZE_BYTES": "268435456"
    },
    "rust-analyzer.check.extraEnv": {
        "MEMORY_SIZE_BYTES": "268435456"
    },
    "rust-analyzer.checkOnSave": true,
    "rust-analyzer.check.overrideCommand": [
        "./z",
        "build",
        "--",
        "check"
    ]
}
