// Visual Studio Code Settings for Nanvix Development on Windows
//
// How to use:
// 1. Create a folder named '.vscode' in the root of your Nanvix workspace.
// 2. Copy this file into the '.vscode' folder as 'settings.json'.
// 3. To run the same check as Rust Analyzer from a terminal, run:
//      z.ps1 build -- check
//    It checks all crates: host crates (such as uservm, nanvixd, nanvix-test, and mkramfs)
//    natively, and the kernel and guest crates by cross-compiling them.
// 4. To check fewer crates, use the per-component targets, for example:
//      z.ps1 build -- check-uservm
//      z.ps1 build -- check-kernel
//      z.ps1 build -- check-guest-binaries
//
// Notes:
// - Rust Analyzer routes check-on-save and build-script discovery through './z.bat build -- check'.
{
    //==============================================================================================
    // Editor Settings
    //==============================================================================================
    "editor.colorDecorators": false,
    "editor.formatOnType": false,
    "editor.formatOnSave": true,
    "editor.rulers": [
        100
    ],
    "vim.textwidth": 100,
    "files.watcherExclude": {
        "**/__pycache__/**": true,
        "**/.git/**": true,
        "**/.hg/**": true,
        "bin/**": true,
        "lib/**": true,
        "sysroot-*/**": true,
        "target/**": true
    },
    "files.exclude": {
        "**/__pycache__/**": true,
        "target/**": true,
        "**/*.elf": true
    },
    //==============================================================================================
    // Rust Analyzer Settings
    //==============================================================================================
    "rust-analyzer.cargo.allTargets": false,
    "rust-analyzer.cargo.extraEnv": {
        "MEMORY_SIZE_BYTES": "268435456"
    },
    "rust-analyzer.check.extraEnv": {
        "MEMORY_SIZE_BYTES": "268435456"
    },
    "rust-analyzer.checkOnSave": true,
    "rust-analyzer.files.exclude": [
        "target",
        "sysroot",
        "sysroot-debug",
        "sysroot-release"
    ],
    "rust-analyzer.cargo.buildScripts.overrideCommand": [
        "./z.bat",
        "build",
        "--",
        "check",
        "MESSAGE_FORMAT=json"
    ],
    "rust-analyzer.check.overrideCommand": [
        "./z.bat",
        "build",
        "--",
        "check",
        "MESSAGE_FORMAT=json"
    ],
    "rust-analyzer.cargo.features": [
        "standalone"
    ]
}
