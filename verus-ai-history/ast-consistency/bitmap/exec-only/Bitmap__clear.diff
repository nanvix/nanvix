+
+        // At this point, we know:
+        // - old_self.inv() holds
+        // - old_self.is_bit_set(index as int) (the bit is set)
+        self.bits.set(word, self.bits[word] & !(1 << bit));
+
+        self.usage = self.usage - 1;
+
         Ok(())
     }
