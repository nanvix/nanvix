# Workspace path artifacts (created by Docker builds with WORKSPACE_PATH).
# When building with Docker, the WORKSPACE_PATH arg mirrors the host's absolute
# path inside the container. The --output directive then extracts artifacts,
# which may include these path prefixes. Ignore them to avoid committing
# host-specific path structures. These patterns only match at the repo root.
/home/*/
/Users/*/
/root/*/

# Toolchain Directories
build-binutils
build-gcc
build-gdb
toolchain

# Build artifacts
.venv/
bin/
/lib/
/logs/
plots/
target/
/sysroot-debug/
/sysroot-release/
sysroot
*.a
*.elf
*.exe
*.img
*.iso
*.log
*.o
*.obj
.z.cache

# Python cache
__pycache__/
*.pyc
*.pyo

# Verus download cache
.verus-cache/

# IDEs
*.swo
*.swp
*.vscode/
snapshots/*.vmem
snapshots/*.kvm.json
snapshots/*.whp.cbor

# Third-party tools (cloned locally)
tools/

# Benchmark state file (generated by bench-setup.ps1)
scripts/bench/.bench-state.json
