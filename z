#
# Utility for building Nanvix.
#
# Run './z help' for more information on how to use this utility.
#

#==================================================================================================

# Fast fail on errors, unset variables, and pipe failures.
set -euo pipefail

#==================================================================================================
# Imports
#==================================================================================================

# Directory where to find scripts to import.
IMPORT_DIR="$(cd "$(dirname "$0")" && pwd)/scripts/common"

source "${IMPORT_DIR}/logging.sh"
source "${IMPORT_DIR}/utils.sh"

#==================================================================================================
# Global Constants
#==================================================================================================

# Root directory of the repository.
REPO_ROOT_DIR=$(git rev-parse --show-toplevel)

# Cargo.toml file path.
CARGO_TOML_FILE_PATH="${REPO_ROOT_DIR}/Cargo.toml"

# Command names.
CMD_NAME_BUILD="build"
CMD_NAME_CLEANUP="cleanup"
CMD_NAME_SETUP="setup"
CMD_NAME_HELP="help"

# Option names.
OPT_NAME_SEPARATOR="--"
OPT_NAME_WITH_DOCKER="--with-docker"
OPT_NAME_WITH_CACHED_OPTIONS="--with-cached-options"
OPT_NAME_TOOLCHAIN_DIR="--toolchain-dir"

# Name of the Docker image with the Nanvix toolchain.
DOCKER_IMAGE_BASE_NAME="nanvix/toolchain"

# Path to the toolchain inside the Docker image.
DOCKER_IMAGE_TOOLCHAIN_PATH="/opt/nanvix"

# Cache file to store the last build command and options.
Z_CACHE_FILE=".z.cache"

# Default toolchain directory for setup.
DEFAULT_LOCAL_TOOLCHAIN_DIR="${HOME}/toolchain"

#==================================================================================================
# Global Variables
#==================================================================================================

# Options from cache.
LAST_BUILD_WITH_DOCKER=false  # Was the last build done with Docker?

# Current options.
BUILD_WITH_DOCKER=false                         # Build with Docker?
WITH_CACHED_OPTIONS=false                       # Use cached options (if any)?
TOOLCHAIN_DIR="${DEFAULT_LOCAL_TOOLCHAIN_DIR}"  # Toolchain directory for setup.

#==================================================================================================
# Functions
#==================================================================================================

#
# Description
#   Prints help information on stdout.
#
# Usage Example
#   print_help
#
print_help() {
    cat << EOF
Utility for building Nanvix.

Usage:
  ./z COMMAND [OPTIONS] [${OPT_NAME_SEPARATOR} BUILD_TARGET BUILD_PARAMETERS]
  ./z ${CMD_NAME_BUILD} [${OPT_NAME_WITH_DOCKER}] [${OPT_NAME_WITH_CACHED_OPTIONS}] [${OPT_NAME_SEPARATOR} BUILD_TARGET BUILD_PARAMETERS]
  ./z ${CMD_NAME_CLEANUP} [${OPT_NAME_WITH_DOCKER}]
  ./z ${CMD_NAME_SETUP} [${OPT_NAME_WITH_DOCKER}] [${OPT_NAME_TOOLCHAIN_DIR} <path>]
  ./z ${CMD_NAME_HELP}

Commands
  build    Builds Nanvix.
  cleanup  Cleans up build artifacts.
  setup    Sets up the Nanvix development environment.
  help     Prints the help information.

Options
  ${OPT_NAME_WITH_DOCKER}           Build Nanvix using Docker instead of the local toolchain.
  ${OPT_NAME_WITH_CACHED_OPTIONS}   Use cached options from the last build.
  ${OPT_NAME_TOOLCHAIN_DIR} <path>  Specify the toolchain directory for setup (default: ${DEFAULT_LOCAL_TOOLCHAIN_DIR}).
EOF
    if ! make help; then
        print_error "Failed to get help on build targets and parameters."
        exit 1
    fi
}

#
# Description
#
#   Checks if Docker is installed and aborts if it is not.
#
# Usage Example
#   check_docker_installed
#
check_docker_installed() {
    if ! command -v docker >/dev/null 2>&1; then
        print_error "Docker is not installed. Please install Docker to build with Docker."
        exit 1
    fi
}

#
# Description
#
#   Checks if the Docker image is available locally and aborts if it is not.
#
# Arguments
#   $1 - The name of the Docker image to check.
#
# Usage Example
#   check_docker_image_available "nanvix/toolchain:v1.0.x"
#
check_docker_image_available() {
    local image_name="$1"
    if ! docker image inspect "${image_name}" >/dev/null 2>&1; then
        print_error "Docker image '${image_name}' not found. Please pull it first."
        exit 1
    fi
}

#
# Description
#
#   Returns the name of the Docker image to use for building Nanvix.
#
# Arguments
#  $1 - The version of the Docker image to use.
#
# Usage Example
#   get_docker_image_name "v1.0.0"
#
get_docker_image_name() {
    # Build image tag version by replacing patch with "x".
    local image_tag_version
    image_tag_version="${1%.*}.x"
    echo "${DOCKER_IMAGE_BASE_NAME}:v${image_tag_version}"
}

#
# Description
#   Builds the Docker command to run the build process.
#
# Arguments
#   $* - The build parameters to pass to the Docker command.
#
# Return
#   A string containing the Docker command to run.
#
# Usage Example
#   build_docker_command "all"
#
build_docker_command() {
    local build_parameters="${*}"
    local user_id
    local group_id
    user_id="$(id -u)"
    group_id="$(id -g)"

    # Check if Docker is installed.
    check_docker_installed

    local current_version
    current_version=$(get_cargo_toml_version "$CARGO_TOML_FILE_PATH")

    # Get the Docker image name.
    local image_name
    image_name=$(get_docker_image_name "${current_version}")

    # Check if the Docker image is available.
    check_docker_image_available "${image_name}"

    echo "docker run --rm \
        -v \"$(pwd):/mnt\" \
        ${image_name} \
        /bin/bash -l -c '\
            cd /mnt ; \
            git config --global --add safe.directory /mnt ; \
            make TOOLCHAIN_DIR=${DOCKER_IMAGE_TOOLCHAIN_PATH} ${build_parameters} ; \
            chown -R \"${user_id}:${group_id}\" .\
        '"
}

#
# Description
#   Writes the last build command and options to the cache file.
#   Each argument is written on a separate line.
#
# Arguments
#   $@ - The full command line arguments.
#
# Usage Example
#   write_cache "build" "--with-docker" "--" "all"
#
write_cache() {
    printf '%s\n' "${@}" > "${Z_CACHE_FILE}"
}

#
# Description
#   Reads the last build command and options from the cache file.
#   Sets the following global variables based on whether the cache contains the Docker option:
#   - LAST_BUILD_WITH_DOCKER: true if the last build was done with Docker, false otherwise.
#
# Usage Example
#   read_cache
#
read_cache() {
    if [[ -f "${Z_CACHE_FILE}" ]]; then
        local cache_lines
        mapfile -t cache_lines < "${Z_CACHE_FILE}"
        # Check if the cache file is empty.
        if [[ ${#cache_lines[@]} -eq 0 ]]; then
            return
        fi
        # Process the cache lines to determine the last build options.
        for arg in "${cache_lines[@]}"; do
            if [[ "$arg" == "${OPT_NAME_WITH_DOCKER}" ]]; then
                LAST_BUILD_WITH_DOCKER=true
            elif [[ "$arg" == "${OPT_NAME_SEPARATOR}" ]]; then
                break
            fi
        done
    fi
}

#
# Description
#
#   Checks if the specified directory resides on a supported file system (ext3/ext4). The toolchain
#   build requires extended attributes support for setcap commands.
#
# Arguments
#
#   $1 - The directory path to check.
#
# Return Value
#
#   - 0 if the file system is supported.
#   - 1 if the findmnt command is not available.
#   - 2 if the directory path is empty.
#   - 3 if the file system type cannot be determined.
#   - 4 if the file system is not supported.
#
# Usage Example
#
#   check_filesystem_support "/path/to/toolchain"
#
check_filesystem_support() {
    local target_dir="$1"

    # Check if findmnt command is available.
    if ! command -v findmnt >/dev/null 2>&1; then
        print_warning "Cannot detect file system type (findmnt not available)."
        return 1
    fi

    # Check if `target_dir` is empty.
    if [[ -z "${target_dir}" ]]; then
        print_warning "Toolchain directory path is empty."
        return 2
    fi

    # Find first parent directory for `target_dir` that exists.
    local parent_dir="${target_dir}"
    while [[ ! -d "${parent_dir}" ]]; do
        if [[ "${parent_dir}" == "/" ]]; then
            break
        fi
        parent_dir="$(dirname "${parent_dir}")"
    done

    # Get the file system type for the existing directory.
    local fs_type
    if ! fs_type=$(findmnt -n -o FSTYPE --target "${parent_dir}" 2>/dev/null); then
        print_warning "Cannot detect file system type for '${target_dir}'."
        return 3
    fi

    # Check if the file system supports extended attributes.
    case "${fs_type}" in
        ext3|ext4)
            return 0
            ;;
        *)
            print_warning "Unsupported file system '${fs_type}' detected for toolchain directory '${target_dir}'"
            print_warning "Only ext3/ext4 are supported because extended attributes (xattr) are required for setcap commands."
            print_warning "Consider moving the toolchain directory to a partition formatted with ext3 or ext4."
            return 4
            ;;
    esac
}

#==================================================================================================
# Main Script
#==================================================================================================

main() {
    # Check if the script is running on a valid Git repository.
    if ! git rev-parse --is-inside-work-tree &> /dev/null; then
        print_error "This script must be run inside a Git repository."
        exit 1
    fi

    # Check if the script is being run from the root of the repository.
    if [[ "$(pwd)/z" != "${REPO_ROOT_DIR}/z" ]]; then
        print_error "This script must be run from the root of the repository."
        exit 1
    fi

    # Check if no command was provided.
    if [[ $# -eq 0 ]]; then
        print_error "No command provided."
        print_help
        exit 1
    fi

    # Extract command from arguments.
    local command
    command="$1"
    shift

    # Read last build info from cache
    read_cache

    # Parse command options.
    while [[ $# -gt 0 ]]; do
        case "$1" in
            "${OPT_NAME_WITH_DOCKER}")
                BUILD_WITH_DOCKER=true
                shift
                ;;
            "${OPT_NAME_WITH_CACHED_OPTIONS}")
                WITH_CACHED_OPTIONS=true
                shift
                ;;
            "${OPT_NAME_TOOLCHAIN_DIR}")
                if [[ $# -lt 2 ]] || [[ "$2" == "--"* ]]; then
                    print_error "Missing path for ${OPT_NAME_TOOLCHAIN_DIR}"
                    exit 1
                fi
                TOOLCHAIN_DIR="$2"
                shift 2
                ;;
            "${OPT_NAME_SEPARATOR}")
                shift
                break
                ;;
            *)
                print_error "Unknown option: $1"
                exit 1
                ;;
        esac
    done

    # Collect build parameters.
    local build_parameters=()
    while [[ $# -gt 0 ]]; do
        build_parameters+=("$1")
        shift
    done

    # If using cache, restore variables from cache if not set by command line
    if ${WITH_CACHED_OPTIONS}; then
        print_info "Using cached build options."
        # Only override if not set by command line
        if ! ${BUILD_WITH_DOCKER}; then
            BUILD_WITH_DOCKER=${LAST_BUILD_WITH_DOCKER}
        fi
    fi

    case "${command}" in
        "${CMD_NAME_BUILD}")
            print_info "Command: ${command}"
            print_info "Build with Docker: ${BUILD_WITH_DOCKER}"
            print_info "Build Parameters: ${build_parameters[*]}"

            # Check if we are switching build modes.
            if ${BUILD_WITH_DOCKER} && ! ${LAST_BUILD_WITH_DOCKER}; then
                print_warning "Switching to Docker build, forcing cleanup."
                # Force a cleanup.
                if ! eval "$(build_docker_command distclean)" ; then
                    print_error "Cleanup failed with Docker."
                    exit 1
                fi
            elif ! ${BUILD_WITH_DOCKER} && ${LAST_BUILD_WITH_DOCKER}; then
                print_warning "Switching to local toolchain build, forcing cleanup."
                # Force a cleanup.
                if ! make distclean ; then
                    print_error "Cleanup failed with local toolchain."
                    exit 1
                fi
            fi


            # Build Nanvix.
            if ${BUILD_WITH_DOCKER}; then
                print_info "Building with Docker..."
                if ! eval "$(build_docker_command "${build_parameters[@]}")"; then
                    print_error "Build failed with Docker."
                    exit 1
                fi
            else
                print_info "Building with local toolchain..."
                if ! make "${build_parameters[@]}"; then
                    print_error "Build failed."
                    exit 1
                fi
            fi

            # Save current build command and options to cache.
            cache_args=("${command}")
            ${BUILD_WITH_DOCKER} && cache_args+=("${OPT_NAME_WITH_DOCKER}")
            cache_args+=("${OPT_NAME_SEPARATOR}" "${build_parameters[@]}")
            write_cache "${cache_args[@]}"
            ;;

        "${CMD_NAME_CLEANUP}")
            # Cleanup build artifacts.
            if ${BUILD_WITH_DOCKER}; then
                print_info "Cleaning up with Docker..."
                if ! eval "$(build_docker_command distclean)"; then
                    print_error "Cleanup failed with Docker."
                    exit 1
                fi
            else
                print_info "Cleaning up with local toolchain..."
                if ! make distclean; then
                    print_error "Cleanup failed."
                    exit 1
                fi
            fi

            # Remove cache file.
            if [[ -f "${Z_CACHE_FILE}" ]]; then
                rm -f "${Z_CACHE_FILE}"
                print_success "Cache file removed."
            fi
            ;;

        "${CMD_NAME_SETUP}")
            # Setup the Nanvix development environment.
            print_info "Setting up Nanvix development environment..."

            # If Docker is requested, download the Docker image.
            if ${BUILD_WITH_DOCKER}; then
                print_info "Docker setup requested, downloading Docker image..."

                # Check if Docker is installed.
                check_docker_installed

                # Get the Docker image name using the same logic as build_docker_command
                local current_version
                current_version=$(get_cargo_toml_version "$CARGO_TOML_FILE_PATH")

                # Get the Docker image name.
                local image_name
                image_name=$(get_docker_image_name "${current_version}")

                # Pull the Docker image.
                print_info "Pulling Docker image: ${image_name}"
                if ! docker pull "${image_name}"; then
                    print_error "Failed to pull Docker image '${image_name}'."
                    exit 1
                fi

                print_success "Docker image '${image_name}' downloaded successfully."
            else
                print_info "Toolchain directory: ${TOOLCHAIN_DIR}"

                # Ensure the toolchain directory exists; create it if it does not.
                if [[ ! -d "${TOOLCHAIN_DIR}" ]]; then
                    print_info "Toolchain directory '${TOOLCHAIN_DIR}' does not exist. Creating it..."
                    if ! mkdir -p "${TOOLCHAIN_DIR}"; then
                        print_error "Failed to create toolchain directory '${TOOLCHAIN_DIR}'. Please check your permissions or specify another directory."
                        exit 1
                    fi
                fi

                # Check if user has write permissions to the toolchain directory.
                if [[ ! -w "${TOOLCHAIN_DIR}" ]]; then
                    print_error "No write permissions to: ${TOOLCHAIN_DIR}. Run with appropriate permissions or specify another directory."
                    exit 1
                fi

                # Check if the toolchain directory is on a supported file system.
                check_filesystem_support "${TOOLCHAIN_DIR}" || {
                    print_error "Toolchain directory '${TOOLCHAIN_DIR}' is not on a supported file system (ext3/ext4)."
                    exit 1
                }

                # Warn if toolchain directory is not empty.
                if [ "$(ls -A "${TOOLCHAIN_DIR}" 2>/dev/null)" ]; then
                    print_warning "Toolchain directory is not empty: ${TOOLCHAIN_DIR}. Existing files may be overwritten."
                fi

                # Path to the main setup script
                local setup_script="${REPO_ROOT_DIR}/scripts/setup/toolchain.sh"

                # Check if setup script exists
                if [[ ! -f "${setup_script}" ]]; then
                    print_error "Setup script not found: ${setup_script}"
                    exit 1
                fi

                # Run the setup script
                print_info "Running setup script: ${setup_script}"
                if ! "${setup_script}" "${TOOLCHAIN_DIR}"; then
                    print_error "Setup failed."
                    exit 1
                fi
            fi

            print_success "Nanvix development environment setup completed successfully."
            ;;

        "${CMD_NAME_HELP}")
            print_help
            ;;
        *)
            print_error "Unknown command: '${command}'"
            print_help
            exit 1
            ;;
    esac
}

main "${@}"
